{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "millennium": [
        "./.millennium/lsp/ts"
      ]
    },
    "typeRoots": [
      "./.millennium/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "frontend",
    "preview",
    ".millennium/**/*.d.ts"
  ]
}